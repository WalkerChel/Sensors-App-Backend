########################################
# HTTP Server                          #
########################################
HTTP_SERVER_HOST=localhost
HTTP_SERVER_PORT=8080
HTTP_SERVER_READ_TIMEOUT=3m
HTTP_SERVER_WRITE_TIMEOUT=3m
HTTP_SERVER_SHUTDOWN_TIMEOUT=5m

########################################
# Security & Authentication            #
########################################
TOKEN_TTL=30m
TOKEN_SIGN_KEY=your_sign_key

########################################
# PostgreSQL Database                  #
########################################
POSTGRES_HOST=localhost
POSTGRES_DB=app-postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=qwerty
POSTGRES_SSL_MODE=disable

########################################
# Redis Cache                          #
########################################
REDIS_HOST=localhost
REDIS_CONTAINER_NAME=app-redis
REDIS_PORT=6379
REDIS_USER=admin
REDIS_USER_PASSWORD=qwerty
REDIS_PASSWORD=qwerty
REDIS_DB=0

########################################
# Project & System Paths               #
########################################
VOLUMES_PATH=/your/path/to/volumes
MIGRATIONS_PATH=/your/path/to/migrations
